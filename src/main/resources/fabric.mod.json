{
  "schemaVersion": 1,
  "id": "wes",
  "version": "${version}",
  "name": "WES - WorldEdit Select",
  "description": "在聊天框输入 //set （带空格）即可弹出方块选择面板，点选方块并分配百分比，一键生成 //set 指令。",
  "authors": [
    "WES"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/wes/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.wes.WesClient"
    ]
  },
  "mixins": [
    {
      "config": "wes.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.14.0",
    "minecraft": ">=1.20 <1.20.2",
    "java": ">=17",
    "worldedit": ">=7.2.0"
  }
}
